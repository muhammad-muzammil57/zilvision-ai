# --- NextAuth (login system) ---
# Random secret, generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Google OAuth (Continue with Google) ---
# Get these from https://console.cloud.google.com/apis/credentials
# Authorized redirect URI to add there:
# http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Groq (free chat AI) ---
# Get a free key from https://console.groq.com/keys
GROQ_API_KEY=

# --- Image generation ---
# Pollinations.ai needs NO key at all (fully free, no daily limit).
# Leave this blank unless you switch providers later.
POLLINATIONS_BASE_URL=https://image.pollinations.ai/prompt
