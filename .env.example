# --- NextAuth (login system) ---
# Random secret, generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Google OAuth (Continue with Google) ---
# Get these from https://console.cloud.google.com/apis/credentials
# Authorized redirect URI to add there:
# http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Groq (free chat AI) ---
# Get a free key from https://console.groq.com/keys
GROQ_API_KEY=

# --- Image generation ---
# The Image Studio now offers the user 3 choices (picked from a dropdown in
# the UI, no server env var needed for any of them):
#   1. "Fast (Free)"      -> Pollinations flux model. No key.
#   2. "Accurate (Free)"  -> Pollinations nanobanana model. No key, much
#                             better prompt-following.
#   3. "Gemini (Your API Key)" -> Each user pastes their OWN Gemini key in
#                             the UI. We call Google directly with it per
#                             request; the key is never stored on our
#                             server and that user's own quota/credits are
#                             used, not ours.
# Pollinations.ai needs NO key at all (fully free, no daily limit).
POLLINATIONS_BASE_URL=https://image.pollinations.ai/prompt
