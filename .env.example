# --- NextAuth (login system) ---
# Random secret, generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Google OAuth (Continue with Google) ---
# Get these from https://console.cloud.google.com/apis/credentials
# Authorized redirect URI to add there:
# http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Groq (free chat AI) ---
# Get a free key from https://console.groq.com/keys
GROQ_API_KEY=

# --- Image generation ---
# The Image Studio offers the user 4 choices (picked from a dropdown in the
# UI):
#   1. "Fast (Free)"              -> Pollinations flux model. No key.
#   2. "Accurate (Free)"          -> Pollinations nanobanana model (falls
#                                     back to gptimage, then flux). No key.
#   3. "Flux / SDXL (Hugging Face)" -> Hugging Face Inference API, using
#                                     FLUX.1-schnell with stable-diffusion-
#                                     xl-base-1.0 as a fallback. Needs
#                                     HUGGINGFACE_API_KEY below — visitors
#                                     don't need their own key.
#   4. "Gemini (Your API Key)"    -> Each user pastes their OWN Gemini key
#                                     in the UI. We call Google directly
#                                     with it per request; the key is never
#                                     stored on our server and that user's
#                                     own quota/credits are used, not ours.
#
# Every image, from every provider above, gets a small "Muzammil" watermark
# stamped on it server-side (see lib/watermark.ts) before it's sent back.

# Pollinations.ai needs NO key at all (fully free, no daily limit).
POLLINATIONS_BASE_URL=https://image.pollinations.ai/prompt

# Hugging Face — get a free access token (needs "Inference Providers"
# permission) from https://huggingface.co/settings/tokens/new?ownUserPermissions=inference.serverless.write&tokenType=fineGrained
# IMPORTANT: as of mid-2026, Hugging Face's old unlimited free serverless
# Inference API is gone. Image models like Flux now run through
# "Inference Providers" (fal-ai, together, replicate, etc.) and free
# accounts get a small monthly credit allowance, not unlimited generations.
# Treat this provider as a bonus/backup, not your main free tier — the
# "Fast (Free)" and "Accurate (Free)" Pollinations options above remain
# the truly unlimited free options.
HUGGINGFACE_API_KEY=
# Optional: override the default model. Must be a text-to-image model
# available on Hugging Face's Inference Providers.
HUGGINGFACE_IMAGE_MODEL=black-forest-labs/FLUX.1-dev
